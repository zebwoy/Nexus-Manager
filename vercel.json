{
  "rewrites": [
    { "source": "/api/super-admin/(.*)",      "destination": "/api/super-admin?action=$1" },
    { "source": "/api/super-admin",           "destination": "/api/super-admin" },

    { "source": "/api/auth-login",           "destination": "/api/auth?action=login" },
    { "source": "/api/auth-audit",            "destination": "/api/auth?action=audit" },
    { "source": "/api/users",                 "destination": "/api/auth?action=users" },
    { "source": "/api/users/(.*)",            "destination": "/api/auth?action=users&id=$1" },

    { "source": "/api/devices",               "destination": "/api/setup?resource=devices" },
    { "source": "/api/pricing",               "destination": "/api/setup?resource=pricing" },
    { "source": "/api/settings",              "destination": "/api/setup?resource=settings" },
    { "source": "/api/purge",                 "destination": "/api/setup?resource=purge" },
    { "source": "/api/platforms",             "destination": "/api/setup?resource=platforms" },
    { "source": "/api/blob-upload",           "destination": "/api/setup?resource=blob-upload" },
    { "source": "/api/blob-proxy",            "destination": "/api/setup?resource=blob-proxy" },
    { "source": "/api/profile-changes",       "destination": "/api/setup?resource=profile-changes" },
    { "source": "/api/profile-changes/(.*)",  "destination": "/api/setup?resource=profile-changes&id=$1" },

    { "source": "/api/customers/:id/ledger",  "destination": "/api/inventory?resource=customers&id=:id&action=ledger" },
    { "source": "/api/customers/:id/settle",  "destination": "/api/inventory?resource=customers&id=:id&action=settle" },
    { "source": "/api/customers/:id/balance", "destination": "/api/inventory?resource=customers&id=:id&action=balance" },
    { "source": "/api/customers",             "destination": "/api/inventory?resource=customers" },
    { "source": "/api/customers/(.*)",        "destination": "/api/inventory?resource=customers&id=$1" },
    { "source": "/api/expenses",              "destination": "/api/inventory?resource=expenses" },
    { "source": "/api/expenses/(.*)",         "destination": "/api/inventory?resource=expenses&id=$1" },
    { "source": "/api/sales",                 "destination": "/api/inventory?resource=sales" },
    { "source": "/api/sales/(.*)",            "destination": "/api/inventory?resource=sales&sale_id=$1" },

    { "source": "/api/pancafe-plans",         "destination": "/api/pancafe?resource=plans" },
    { "source": "/api/pancafe-plans/(.*)",    "destination": "/api/pancafe?resource=plans&id=$1" },

    { "source": "/api/recharges/(.*)",        "destination": "/api/recharges?path=$1" },

    { "source": "/api/dashboard-snapshot",   "destination": "/api/dashboard?target=snapshot" },
    { "source": "/api/dashboard-credits",    "destination": "/api/dashboard?target=credits" },
    { "source": "/api/day-openings",          "destination": "/api/dashboard?target=day-openings" },

    { "source": "/api/sessions/(.*)",         "destination": "/api/sessions?path=$1" },
    { "source": "/api/pancafe/(.*)",          "destination": "/api/pancafe?path=$1" },
    { "source": "/((?!api/.*).*)",            "destination": "/index.html" }
  ]
}
